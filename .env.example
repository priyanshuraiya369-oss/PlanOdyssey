# Gemini Flash server-side key. Never expose this with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Planner generation can take longer than a short chatbot reply; the server allows 45 seconds.
# Optional override for a compatible Gemini generateContent endpoint.
GEMINI_API_URL=

# Google OAuth web application credentials. Add http://localhost:3000/api/auth/google/callback
# (or your deployed HTTPS callback) to Google's authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
