# Gemini Flash server-side key. Never expose this with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional override for a compatible Gemini generateContent endpoint.
GEMINI_API_URL=

# Optional Gmail/personal SMTP for real OTP delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
